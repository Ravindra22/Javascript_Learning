{
  "extends": "airbnb-base",
  "env": {
    "browser": true,
    "es6": true,
    "worker": true
  },
  "parserOptions": {
    "ecmaVersion": 10,
    "sourceType": "module"
  },
  "rules":{
    "linebreak-style": 0,
    "indent": [2, "tab"],
        "no-tabs": 0,
        "no-console": "off",
        "quotes": [2, "double", { "avoidEscape": true }],
        "comma-dangle": "off",
        "@typescript-eslint/comma-dangle": "off"
  }
}